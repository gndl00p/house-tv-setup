# Copy to /opt/house-tv/house.env on the Plex host. That file is not committed.
# LAN address of this machine. Rokus load guide art from it, so 127.0.0.1 will not work for them.
TUNARR_PUBLIC=http://192.0.2.10:8000
HOUSE_TZ=America/Chicago
ZIP_CODE=10001
WEATHER_GUIDE_BLURB=Local forecast, plus the cities in weather/travelcities.json.
# Tunarr as seen from this machine. Change it if Tunarr is not on :8000.
# TUNARR_URL=http://127.0.0.1:8000
# Uncomment if Plex has more than one DVR. Otherwise the first one is used.
# PLEX_DVR_ID=1
# Music library for the jukebox renderer, if it is not named Music.
# PLEX_MUSIC_NAME=Music
# PLEX_MUSIC_SECTION=3
# JUKEBOX_OUT=/mnt/media/Plex/Jukebox
# JUKEBOX_SKIP_ARTISTS=Pink noise: Ref. -14dB Fs|Some Other Artist
# Optional art / station-ID tooling (scripts/art*.py, idents.py). Defaults are art/ and models/ in this repo.
# HOUSE_TV_ART=/opt/house-tv/art
# KOKORO_MODELS=/opt/house-tv/models
# Tunarr filler-list ids holding your commercial clips, for scripts/pools.py.
# COMMERCIAL_LISTS=
